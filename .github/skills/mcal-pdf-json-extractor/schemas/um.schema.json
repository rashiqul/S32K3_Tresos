{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal/um.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "kind", "module", "source", "sections", "configuration_items", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool_version": {"type": "string", "minLength": 1},
    "kind": {"const": "UM"},
    "module": {"type": "string", "minLength": 1},
    "source": {"$ref": "common.schema.json#/$defs/sourceDocument"},
    "sections": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/section"}},
    "configuration_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identifier", "raw_title", "source", "attributes", "extensions"],
        "properties": {
          "kind": {"enum": ["container", "parameter"]},
          "identifier": {"type": "string", "minLength": 1},
          "raw_title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "data_type": {"type": "string"},
              "multiplicity": {"type": "string"},
              "default": {},
              "allowed_values": {"type": "array", "items": {}},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "unit": {"type": "string"},
              "configuration_classes": {"type": "array", "items": {"type": "string"}},
              "constraints": {"type": "array", "items": {"type": "string"}}
            }
          },
          "source": {"$ref": "common.schema.json#/$defs/sourceSpan"},
          "extensions": {"type": "object"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/warning"}}
  }
}