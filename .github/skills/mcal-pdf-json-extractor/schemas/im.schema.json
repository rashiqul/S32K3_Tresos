{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal/im.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "kind", "module", "source", "sections", "topics", "exclusive_areas", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool_version": {"type": "string", "minLength": 1},
    "kind": {"const": "IM"},
    "module": {"type": "string", "minLength": 1},
    "source": {"$ref": "common.schema.json#/$defs/sourceDocument"},
    "sections": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/section"}},
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "title", "source", "identifiers", "extensions"],
        "properties": {
          "category": {"enum": ["exclusive-area", "interrupt", "dependency", "api", "callback", "memory", "integration", "user-mode", "partition", "hardware"]},
          "title": {"type": "string", "minLength": 1},
          "identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source": {"$ref": "common.schema.json#/$defs/sourceSpan"},
          "extensions": {"type": "object"}
        }
      }
    },
    "exclusive_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "source", "uses", "extensions"],
        "properties": {
          "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*_EXCLUSIVE_AREA_[0-9]+$"},
          "uses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source": {"$ref": "common.schema.json#/$defs/sourceSpan"},
          "extensions": {"type": "object"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/warning"}}
  }
}