{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal/module.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "module", "sources", "relationships", "unresolved", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool_version": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["um", "im"],
      "properties": {
        "um": {"$ref": "common.schema.json#/$defs/sourceDocument"},
        "im": {"$ref": "common.schema.json#/$defs/sourceDocument"}
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "from", "to", "confidence"],
        "properties": {
          "type": {"enum": ["documents", "constrains", "implements", "uses-exclusive-area", "calls", "depends-on", "requires-order", "conflicts-with"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/warning"}}
  }
}