{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal/common.schema.json",
  "$defs": {
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "sha256", "page_count"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page", "page_label", "section", "extraction_method", "confidence"],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1},
        "page_label": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "extraction_method": {"enum": ["pdf-outline", "text-toc", "page-text"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "physical_page": {"type": "integer", "minimum": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "depth", "start_page", "end_page"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "depth": {"type": "integer", "minimum": 0},
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1}
      }
    }
  }
}