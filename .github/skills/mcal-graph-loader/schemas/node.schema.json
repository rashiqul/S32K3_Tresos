{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal-graph/node.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "stable_id", "graph_id", "label", "properties"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "pattern": "^dataset:[0-9a-f]{64}$"},
    "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[0-9a-f]{64}$"},
    "graph_id": {"type": "string", "pattern": "^graph:[0-9a-f]{64}$"},
    "label": {
      "enum": [
        "Dataset",
        "Document",
        "Citation",
        "McalModule",
        "ConfigurationDefinition",
        "ConfigurationContainerDefinition",
        "IntegrationTopic",
        "ExclusiveArea",
        "Api",
        "Callback",
        "XdmInstance",
        "Peripheral",
        "Register",
        "RegisterField",
        "Constraint",
        "Device",
        "Term",
        "GeneratedSymbol",
        "Assertion"
      ]
    },
    "properties": {"type": "object"}
  }
}