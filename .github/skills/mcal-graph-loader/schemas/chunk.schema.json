{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxp.local/mcal-graph/chunk.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "chunk_id",
    "citation_id",
    "source_chunk_id",
    "previous_chunk_id",
    "next_chunk_id",
    "content_type",
    "document_id",
    "document_path",
    "source_type",
    "module_ids",
    "peripheral_ids",
    "term_ids",
    "device_ids",
    "physical_page",
    "page_label",
    "heading_path",
    "text",
    "document_sha256",
    "extraction_method",
    "chunker_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "pattern": "^dataset:[0-9a-f]{64}$"},
    "chunk_id": {"type": "string", "pattern": "^chunk:[0-9a-f]{64}$"},
    "citation_id": {"type": "string", "pattern": "^citation:[0-9a-f]{64}$"},
    "source_chunk_id": {"type": ["string", "null"], "pattern": "^source-chunk:[0-9a-f]{64}$"},
    "previous_chunk_id": {"type": ["string", "null"], "pattern": "^source-chunk:[0-9a-f]{64}$"},
    "next_chunk_id": {"type": ["string", "null"], "pattern": "^source-chunk:[0-9a-f]{64}$"},
    "content_type": {"enum": ["evidence", "source-page"]},
    "document_id": {"type": "string", "pattern": "^document:[0-9a-f]{64}$"},
    "document_path": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "module_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "peripheral_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "term_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "device_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "physical_page": {"type": "integer", "minimum": 1},
    "page_label": {"type": "string", "minLength": 1},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "text": {"type": "string", "minLength": 1},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extraction_method": {"type": "string", "minLength": 1},
    "chunker_version": {"type": "string", "minLength": 1}
  }
}